import("//build/config/features.gni")

# DataSipper streaming detection library
component("streaming") {
  sources = [
    "dom_stream_tracker.cc",
    "dom_stream_tracker.h",
    "stream_database_sync.cc",
    "stream_database_sync.h",
    "stream_registry.cc",
    "stream_registry.h",
    "stream_types.cc",
    "stream_types.h",
  ]

  # JavaScript resources (will be loaded at runtime for now)
  # TODO: Convert to GRIT resources for production
  data = [
    "dom_mutation_tracker.js",
  ]

  defines = [ "DATASIPPER_IMPLEMENTATION" ]

  deps = [
    "//base",
    "//content/public/browser",
    "//sql",
    "//url",
  ]

  # Allow other components to depend on this
  visibility = [
    "//components/datasipper/*",
    "//chrome/browser/datasipper/*",
  ]
}

# Unit tests (to be implemented)
source_set("unit_tests") {
  testonly = true

  sources = [
    # TODO: Add test files
    # "stream_types_unittest.cc",
    # "dom_stream_tracker_unittest.cc",
  ]

  deps = [
    ":streaming",
    "//base/test:test_support",
    "//testing/gtest",
  ]
}
