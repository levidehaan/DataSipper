#include "components/datasipper/exporters/kafka_exporter.h"

#include "base/json/json_writer.h"
#include "base/logging.h"
#include "base/strings/strcat.h"
#include "net/base/load_flags.h"
#include "net/http/http_status_code.h"
#include "net/traffic_annotation/network_traffic_annotation.h"
#include "services/network/public/cpp/resource_request.h"
#include "services/network/public/cpp/simple_url_loader.h"
#include "services/network/public/mojom/url_response_head.mojom.h"

namespace datasipper {

KafkaExporter::KafkaExporter(
    scoped_refptr<network::SharedURLLoaderFactory> url_loader_factory)
    : url_loader_factory_(url_loader_factory) {}

KafkaExporter::~KafkaExporter() = default;

void KafkaExporter::Export(const base::Value& data,
                           const ExportConfig& config,
                           ExportCallback callback) {
  // Get Kafka REST Proxy URL
  const std::string* rest_proxy_url = config.settings.FindString("rest_proxy_url");
  const std::string* topic = config.settings.FindString("topic");

  if (!rest_proxy_url || !topic) {
    LOG(ERROR) << "Kafka export requires 'rest_proxy_url' and 'topic' settings";
    std::move(callback).Run(false, "Missing required settings");
    return;
  }

  // Build Kafka message
  base::Value::Dict kafka_message;
  base::Value::List records;
  base::Value::Dict record;
  record.Set("value", data.Clone());
  records.Append(std::move(record));
  kafka_message.Set("records", std::move(records));

  std::string json_body;
  base::JSONWriter::Write(base::Value(std::move(kafka_message)), &json_body);

  // Create request to Kafka REST Proxy
  std::string url = base::StrCat({*rest_proxy_url, "/topics/", *topic});

  auto resource_request = std::make_unique<network::ResourceRequest>();
  resource_request->url = GURL(url);
  resource_request->method = "POST";
  resource_request->load_flags = net::LOAD_BYPASS_CACHE | net::LOAD_DISABLE_CACHE;
  resource_request->credentials_mode = network::mojom::CredentialsMode::kOmit;
  resource_request->headers.SetHeader("Content-Type", "application/vnd.kafka.json.v2+json");

  net::NetworkTrafficAnnotationTag traffic_annotation =
      net::DefineNetworkTrafficAnnotation("datasipper_kafka_export", R"(
        semantics {
          sender: "DataSipper Kafka Exporter"
          description: "Exports extracted web data to Kafka via REST Proxy"
          trigger: "User-configured workflow execution"
          data: "Extracted structured data from web pages"
          destination: OTHER
        }
        policy {
          cookies_allowed: NO
          setting: "Users can configure this via DataSipper workflows"
        })");

  url_loader_ = network::SimpleURLLoader::Create(
      std::move(resource_request), traffic_annotation);

  url_loader_->AttachStringForUpload(json_body, "application/vnd.kafka.json.v2+json");

  url_loader_->DownloadToStringOfUnboundedSizeUntilCrashAndDie(
      url_loader_factory_.get(),
      base::BindOnce(&KafkaExporter::OnExportComplete,
                     base::Unretained(this),
                     std::move(callback)));
}

void KafkaExporter::TestConnection(
    const ExportConfig& config,
    base::OnceCallback<void(bool success)> callback) {
  const std::string* rest_proxy_url = config.settings.FindString("rest_proxy_url");

  if (!rest_proxy_url) {
    std::move(callback).Run(false);
    return;
  }

  // Try to list topics to test connection
  std::string url = base::StrCat({*rest_proxy_url, "/topics"});

  auto resource_request = std::make_unique<network::ResourceRequest>();
  resource_request->url = GURL(url);
  resource_request->method = "GET";
  resource_request->load_flags = net::LOAD_BYPASS_CACHE | net::LOAD_DISABLE_CACHE;

  net::NetworkTrafficAnnotationTag traffic_annotation =
      net::DefineNetworkTrafficAnnotation("datasipper_kafka_test", R"(
        semantics {
          sender: "DataSipper Kafka Exporter"
          description: "Tests connection to Kafka REST Proxy"
          trigger: "User tests Kafka export configuration"
          data: "No user data, just connection test"
          destination: OTHER
        }
        policy {
          cookies_allowed: NO
          setting: "Users can configure this via DataSipper workflows"
        })");

  url_loader_ = network::SimpleURLLoader::Create(
      std::move(resource_request), traffic_annotation);

  url_loader_->DownloadToStringOfUnboundedSizeUntilCrashAndDie(
      url_loader_factory_.get(),
      base::BindOnce(&KafkaExporter::OnTestComplete,
                     base::Unretained(this),
                     std::move(callback)));
}

void KafkaExporter::OnExportComplete(
    ExportCallback callback,
    std::unique_ptr<std::string> response_body) {
  int response_code = -1;
  if (url_loader_->ResponseInfo() && url_loader_->ResponseInfo()->headers) {
    response_code = url_loader_->ResponseInfo()->headers->response_code();
  }

  bool success = (response_code >= 200 && response_code < 300);

  if (success) {
    LOG(INFO) << "Successfully exported to Kafka";
    std::move(callback).Run(true, "");
  } else {
    std::string error = base::StrCat({
        "Kafka export failed with HTTP ", base::NumberToString(response_code)});
    LOG(ERROR) << error;
    std::move(callback).Run(false, error);
  }
}

void KafkaExporter::OnTestComplete(
    base::OnceCallback<void(bool success)> callback,
    std::unique_ptr<std::string> response_body) {
  int response_code = -1;
  if (url_loader_->ResponseInfo() && url_loader_->ResponseInfo()->headers) {
    response_code = url_loader_->ResponseInfo()->headers->response_code();
  }

  bool success = (response_code >= 200 && response_code < 300);
  std::move(callback).Run(success);
}

}  // namespace datasipper
