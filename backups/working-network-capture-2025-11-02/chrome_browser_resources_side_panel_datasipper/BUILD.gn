import("//chrome/common/features.gni")
import("//ui/webui/resources/tools/build_webui.gni")

assert(enable_datasipper)

build_webui("build") {
  grd_prefix = "datasipper"

  static_files = [
    "datasipper.html",
    "datasipper.css",
  ]

  ts_files = [
    "datasipper.ts",
  ]

  mojo_files_deps = [
    "//chrome/browser/ui/webui/side_panel/datasipper:mojo_bindings_ts__generator",
  ]
  mojo_files = [ "$root_gen_dir/chrome/browser/ui/webui/side_panel/datasipper/datasipper.mojom-webui.ts" ]

  ts_deps = [
    "//ui/webui/resources/js:build_ts",
    "//ui/webui/resources/mojo:build_ts",
  ]
}
