+namespace datasipper {
+
+// Observer interface for buffer events
+class CircularEventBufferObserver {
+ public:
+  virtual ~CircularEventBufferObserver() = default;
+  virtual void OnEventAdded(const NetworkEvent& event) = 0;
+  virtual void OnEventEvicted(const NetworkEvent& event) = 0;
+  virtual void OnBufferFull() = 0;
+};
+
+// High-performance circular buffer for network events
+// Thread-safe implementation optimized for high-frequency writes
+class CircularEventBuffer {
+ public:
+  explicit CircularEventBuffer(size_t capacity = 10000);
+  ~CircularEventBuffer();
+
+  CircularEventBuffer(const CircularEventBuffer&) = delete;
+  CircularEventBuffer& operator=(const CircularEventBuffer&) = delete;
+
+  // Event operations
+  void AddEvent(std::unique_ptr<NetworkEvent> event);
+  std::vector<std::unique_ptr<NetworkEvent>> GetEvents(size_t max_count = 0) const;
+  std::vector<std::unique_ptr<NetworkEvent>> GetEventsSince(base::Time since) const;
+  std::unique_ptr<NetworkEvent> GetEvent(const std::string& event_id) const;
+  
+  // Filtering operations
+  std::vector<std::unique_ptr<NetworkEvent>> GetEventsByStream(
+      const std::string& stream_name, size_t max_count = 0) const;
+  std::vector<std::unique_ptr<NetworkEvent>> GetEventsByGroup(
+      const std::string& group_name, size_t max_count = 0) const;
+  std::vector<std::unique_ptr<NetworkEvent>> GetEventsByUrl(
+      const std::string& url_pattern, size_t max_count = 0) const;
+  
+  // Statistics
+  size_t GetSize() const;
+  size_t GetCapacity() const { return capacity_; }
+  size_t GetTotalEventsAdded() const;
+  size_t GetTotalEventsEvicted() const;
+  base::Time GetOldestEventTime() const;
+  base::Time GetNewestEventTime() const;
+  
+  // Configuration
+  void SetCapacity(size_t new_capacity);
+  void Clear();
+  
+  // Observer management
+  void AddObserver(CircularEventBufferObserver* observer);
+  void RemoveObserver(CircularEventBufferObserver* observer);
+  
+  // Memory management
+  size_t GetMemoryUsageBytes() const;
+  void TrimToSize(size_t target_size);
+  
+ private:
+  struct EventSlot {
+    std::unique_ptr<NetworkEvent> event;
+    size_t sequence_number = 0;
+    bool is_valid = false;
+  };
+  
+  void NotifyEventAdded(const NetworkEvent& event);
+  void NotifyEventEvicted(const NetworkEvent& event);
+  void NotifyBufferFull();
+  
+  bool MatchesUrlPattern(const std::string& url, const std::string& pattern) const;
+  
+  mutable base::Lock lock_;
+  
+  std::vector<EventSlot> buffer_ GUARDED_BY(lock_);
+  size_t capacity_;
+  size_t head_index_ GUARDED_BY(lock_) = 0;
+  size_t size_ GUARDED_BY(lock_) = 0;
+  size_t sequence_counter_ GUARDED_BY(lock_) = 0;
+  
+  // Statistics
+  size_t total_events_added_ GUARDED_BY(lock_) = 0;
+  size_t total_events_evicted_ GUARDED_BY(lock_) = 0;
+  
+  std::vector<CircularEventBufferObserver*> observers_ GUARDED_BY(lock_);
+  
+  base::WeakPtrFactory<CircularEventBuffer> weak_factory_{this};
+};
+
+}  // namespace datasipper
+
+#endif  // COMPONENTS_DATASIPPER_STORAGE_CIRCULAR_EVENT_BUFFER_H_
