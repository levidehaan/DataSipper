+#ifndef COMPONENTS_DATASIPPER_STORAGE_EVENT_STREAM_MANAGER_H_
+#define COMPONENTS_DATASIPPER_STORAGE_EVENT_STREAM_MANAGER_H_
+
+#include <map>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "base/memory/weak_ptr.h"
+#include "base/observer_list.h"
+#include "base/synchronization/lock.h"
+#include "base/thread_annotations.h"
+#include "components/datasipper/common/network_event.h"
+#include "components/datasipper/storage/circular_event_buffer.h"
+
+namespace datasipper {
+
+class StreamRule;
+class StreamGroup;
+
+// Observer interface for stream events
+class EventStreamObserver {
+ public:
+  virtual ~EventStreamObserver() = default;
+  virtual void OnStreamCreated(const std::string& stream_name) = 0;
+  virtual void OnStreamDestroyed(const std::string& stream_name) = 0;
+  virtual void OnEventRouted(const std::string& stream_name, 
+                           const NetworkEvent& event) = 0;
+  virtual void OnStreamStatisticsUpdated(const std::string& stream_name) = 0;
+};
+
+// Statistics for individual streams
+struct StreamStatistics {
+  size_t total_events = 0;
+  size_t events_per_minute = 0;
+  base::Time first_event_time;
+  base::Time last_event_time;
+  size_t total_bytes_processed = 0;
+  std::map<std::string, size_t> content_type_counts;
+  std::map<int, size_t> status_code_counts;
+  double avg_response_time_ms = 0.0;
+  size_t error_count = 0;
+};
+
+// Manages multiple event streams with routing and buffering
+class EventStreamManager : public CircularEventBufferObserver {
+ public:
+  explicit EventStreamManager(size_t default_buffer_size = 10000);
+  ~EventStreamManager() override;
+
+  EventStreamManager(const EventStreamManager&) = delete;
+  EventStreamManager& operator=(const EventStreamManager&) = delete;
+
+  // Stream management
+  void CreateStream(const std::string& stream_name, size_t buffer_size = 0);
+  void DestroyStream(const std::string& stream_name);
+  bool HasStream(const std::string& stream_name) const;
+  std::vector<std::string> GetStreamNames() const;
+  
+  // Event routing
+  void RouteEvent(std::unique_ptr<NetworkEvent> event, 
+                  const std::string& target_stream = "");
+  void RouteEventToMultipleStreams(std::unique_ptr<NetworkEvent> event,
+                                  const std::vector<std::string>& stream_names);
+  
+  // Event retrieval
+  std::vector<std::unique_ptr<NetworkEvent>> GetEventsFromStream(
+      const std::string& stream_name, size_t max_count = 0) const;
+  std::vector<std::unique_ptr<NetworkEvent>> GetEventsFromAllStreams(
+      size_t max_count = 0) const;
+  std::vector<std::unique_ptr<NetworkEvent>> GetEventsSince(
+      const std::string& stream_name, base::Time since) const;
+  
+  // Stream statistics
+  StreamStatistics GetStreamStatistics(const std::string& stream_name) const;
+  std::map<std::string, StreamStatistics> GetAllStreamStatistics() const;
+  void UpdateStreamStatistics();
+  
+  // Configuration
+  void SetDefaultBufferSize(size_t size);
+  size_t GetDefaultBufferSize() const { return default_buffer_size_; }
+  
+  // Observer management
+  void AddObserver(EventStreamObserver* observer);
+  void RemoveObserver(EventStreamObserver* observer);
+  
+  // Memory management
+  size_t GetTotalMemoryUsage() const;
+  void TrimAllStreams(size_t target_size_per_stream);
+  void ClearAllStreams();
+  
+  // CircularEventBufferObserver implementation
+  void OnEventAdded(const NetworkEvent& event) override;
+  void OnEventEvicted(const NetworkEvent& event) override;
+  void OnBufferFull() override;
+  
+ private:
+  struct StreamInfo {
+    std::unique_ptr<CircularEventBuffer> buffer;
+    StreamStatistics statistics;
+    base::Time created_time;
+    
+    StreamInfo(size_t buffer_size);
+    ~StreamInfo();
+  };
+  
+  std::string DetermineTargetStream(const NetworkEvent& event) const;
+  void UpdateStatisticsForEvent(const std::string& stream_name, 
+                               const NetworkEvent& event);
+  void NotifyStreamCreated(const std::string& stream_name);
+  void NotifyStreamDestroyed(const std::string& stream_name);
+  void NotifyEventRouted(const std::string& stream_name, 
+                        const NetworkEvent& event);
+  void NotifyStatisticsUpdated(const std::string& stream_name);
+  
+  mutable base::Lock lock_;
+  
+  // Stream storage
+  std::map<std::string, std::unique_ptr<StreamInfo>> streams_ GUARDED_BY(lock_);
+  size_t default_buffer_size_;
+  
+  // Default stream for unrouted events
+  static constexpr char kDefaultStreamName[] = "default";
+  
+  // Observers
+  base::ObserverList<EventStreamObserver> observers_;
+  
+  // Statistics update timer
+  base::Time last_statistics_update_;
+  
+  base::WeakPtrFactory<EventStreamManager> weak_factory_{this};
+};
+
+}  // namespace datasipper
+
+#endif  // COMPONENTS_DATASIPPER_STORAGE_EVENT_STREAM_MANAGER_H_