 extern const base::Feature kDesktopPWAsTabStripLinkCapturing;
 
+// DataSipper features
+COMPONENT_EXPORT(CHROME_FEATURES) extern const base::Feature kDataSipperEnabled;
+COMPONENT_EXPORT(CHROME_FEATURES) extern const base::Feature kDataSipperNetworkInterception;
+
 #if BUILDFLAG(IS_CHROMEOS)
 COMPONENT_EXPORT(CHROME_FEATURES)
 extern const base::Feature kDesktopPWAsRunOnOsLoginBehavior;
