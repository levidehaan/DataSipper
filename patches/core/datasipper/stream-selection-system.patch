+// Copyright 2024 The DataSipper Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_DATASIPPER_STREAM_STREAM_SELECTOR_H_
+#define COMPONENTS_DATASIPPER_STREAM_STREAM_SELECTOR_H_
+
+#include <map>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "base/memory/weak_ptr.h"
+#include "base/observer_list.h"
+#include "components/datasipper/stream/stream_group.h"
+#include "components/datasipper/stream/stream_rule.h"
+
+namespace datasipper {
+
+struct NetworkEvent;
+
+// Observer for stream selector events
+class StreamSelectorObserver {
+ public:
+  virtual ~StreamSelectorObserver() = default;
+  virtual void OnRuleAdded(const std::string& rule_name) = 0;
+  virtual void OnRuleRemoved(const std::string& rule_name) = 0;
+  virtual void OnRuleUpdated(const std::string& rule_name) = 0;
+  virtual void OnGroupCreated(const std::string& group_name) = 0;
+  virtual void OnEventRouted(const std::string& group_name, const NetworkEvent& event) = 0;
+};
+
+// Main stream selection engine that routes network events to appropriate groups
+class StreamSelector : public StreamGroupObserver {
+ public:
+  StreamSelector();
+  ~StreamSelector() override;
+  
+  StreamSelector(const StreamSelector&) = delete;
+  StreamSelector& operator=(const StreamSelector&) = delete;
+
+  // Rule management
+  void AddRule(std::unique_ptr<StreamRule> rule);
+  void RemoveRule(const std::string& rule_name);
+  void UpdateRule(const std::string& rule_name, std::unique_ptr<StreamRule> rule);
+  StreamRule* GetRule(const std::string& rule_name);
+  std::vector<std::string> GetRuleNames() const;
+  
+  // Group management
+  void CreateGroup(const std::string& group_name);
+  void RemoveGroup(const std::string& group_name);
+  StreamGroup* GetGroup(const std::string& group_name);
+  std::vector<std::string> GetGroupNames() const;
+  void UpdateGroupConfig(const std::string& group_name, 
+                        const TransformationConfig& transform_config,
+                        const OutputConfig& output_config);
+  
+  // Event processing
+  void ProcessEvent(const NetworkEvent& event);
+  
+  // Observer management
+  void AddObserver(StreamSelectorObserver* observer);
+  void RemoveObserver(StreamSelectorObserver* observer);
+  
+  // StreamGroupObserver implementation
+  void OnEventAdded(const std::string& group_name, const NetworkEvent& event) override;
+  void OnTransformationApplied(const std::string& group_name, const base::Value::Dict& transformed_data) override;
+  void OnOutputSent(const std::string& group_name, const std::string& output_type, bool success) override;
+  
+  // Configuration persistence
+  base::Value::Dict ExportConfiguration() const;
+  bool ImportConfiguration(const base::Value::Dict& config);
+  void ClearConfiguration();
+  
+ private:
+  void EnsureDefaultGroup();
+  std::vector<std::string> FindMatchingGroups(const NetworkEvent& event);
+  
+  std::map<std::string, std::unique_ptr<StreamRule>> rules_;
+  std::map<std::string, std::unique_ptr<StreamGroup>> groups_;
+  
+  base::ObserverList<StreamSelectorObserver> observers_;
+  
+  base::WeakPtrFactory<StreamSelector> weak_factory_{this};
+};
+
+}  // namespace datasipper
+
+#endif  // COMPONENTS_DATASIPPER_STREAM_STREAM_SELECTOR_H_