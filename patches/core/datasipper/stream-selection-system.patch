+
+#ifndef COMPONENTS_DATASIPPER_STREAM_STREAM_GROUP_H_
+#define COMPONENTS_DATASIPPER_STREAM_STREAM_GROUP_H_
+
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "base/observer_list.h"
+#include "base/time/time.h"
+#include "base/values.h"
+
+namespace datasipper {
+
+struct NetworkEvent;
+
+// Configuration for data transformation
+struct TransformationConfig {
+  bool enabled = false;
+  std::string javascript_code;         // Custom transformation script
+  std::string output_format = "json";  // json, avro, protobuf, custom
+  base::Value::Dict field_mappings;    // Field name mappings
+  base::Value::Dict static_fields;     // Static fields to add
+  bool include_metadata = true;        // Include timing, source info
+  
+  base::Value::Dict ToDict() const;
+  static TransformationConfig FromDict(const base::Value::Dict& dict);
+};
+
+// Configuration for output routing
+struct OutputConfig {
+  std::string type;                    // "kafka", "redis", "webhook", "file"
+  bool enabled = false;
+  
+  // Kafka-specific config
+  std::string kafka_topic;
+  int kafka_partition = -1;            // -1 for automatic partitioning
+  std::string kafka_key_field;        // Field to use as message key
+  
+  // Redis-specific config
+  std::string redis_key_pattern;      // Key pattern with substitutions
+  std::string redis_channel;          // Pub/sub channel
+  std::string redis_operation = "set"; // set, lpush, rpush, publish
+  int redis_ttl = -1;                 // TTL in seconds, -1 for no expiry
+  
+  // Webhook-specific config
+  std::string webhook_url;
+  std::string webhook_method = "POST";
+  base::Value::Dict webhook_headers;
+  
+  // File-specific config
+  std::string file_path;
+  std::string file_format = "jsonl";  // jsonl, csv, tsv
+  bool file_append = true;
+  
+  // Common config
+  int batch_size = 1;                 // Number of events to batch
+  int flush_interval_ms = 1000;       // Max time to wait before flushing
+  int max_retries = 3;
+  int retry_delay_ms = 1000;
+  
+  base::Value::Dict ToDict() const;
+  static OutputConfig FromDict(const base::Value::Dict& dict);
+};
+
+// Observer for stream group events
+class StreamGroupObserver {
+ public:
+  virtual ~StreamGroupObserver() = default;
+  virtual void OnEventAdded(const std::string& group_name, const NetworkEvent& event) = 0;
+  virtual void OnTransformationApplied(const std::string& group_name, const base::Value::Dict& transformed_data) = 0;
+  virtual void OnOutputSent(const std::string& group_name, const std::string& output_type, bool success) = 0;
+};
+
+// A group of related network events with transformation and output configuration
+class StreamGroup {
+ public:
+  explicit StreamGroup(const std::string& name);
+  ~StreamGroup();
+  
+  StreamGroup(const StreamGroup&) = delete;
+  StreamGroup& operator=(const StreamGroup&) = delete;
+
+  // Basic properties
+  const std::string& name() const { return name_; }
+  const std::string& description() const { return description_; }
+  void set_description(const std::string& description) { description_ = description; }
+  
+  bool enabled() const { return enabled_; }
+  void set_enabled(bool enabled) { enabled_ = enabled; }
+  
+  // Configuration
+  const TransformationConfig& transformation_config() const { return transformation_config_; }
+  void set_transformation_config(const TransformationConfig& config) { transformation_config_ = config; }
+  
+  const OutputConfig& output_config() const { return output_config_; }
+  void set_output_config(const OutputConfig& config) { output_config_ = config; }
+  
+  // Event processing
+  void AddEvent(const NetworkEvent& event);
+  size_t GetEventCount() const { return event_count_; }
+  base::Time GetLastEventTime() const { return last_event_time_; }
+  
+  // Observer management
+  void AddObserver(StreamGroupObserver* observer);
+  void RemoveObserver(StreamGroupObserver* observer);
+  
+  // Statistics
+  size_t GetTransformationCount() const { return transformation_count_; }
+  size_t GetOutputSuccessCount() const { return output_success_count_; }
+  size_t GetOutputFailureCount() const { return output_failure_count_; }
+  
+  // Serialization
+  base::Value::Dict ToDict() const;
+  static std::unique_ptr<StreamGroup> FromDict(const base::Value::Dict& dict);
+  
+ private:
+  void ProcessEvent(const NetworkEvent& event);
+  base::Value::Dict TransformEvent(const NetworkEvent& event);
+  void SendToOutput(const base::Value::Dict& data);
+  
+  std::string name_;
+  std::string description_;
+  bool enabled_ = true;
+  
+  TransformationConfig transformation_config_;
+  OutputConfig output_config_;
+  
+  // Statistics
+  size_t event_count_ = 0;
+  size_t transformation_count_ = 0;
+  size_t output_success_count_ = 0;
+  size_t output_failure_count_ = 0;
+  base::Time last_event_time_;
+  
+  base::ObserverList<StreamGroupObserver> observers_;
+  
+  // Batching support
+  std::vector<base::Value::Dict> pending_batch_;
+  base::Time last_flush_time_;
+};
+
+}  // namespace datasipper
+
+#endif  // COMPONENTS_DATASIPPER_STREAM_STREAM_GROUP_H_
