+#ifndef COMPONENTS_DATASIPPER_STREAM_STREAM_RULE_H_
+#define COMPONENTS_DATASIPPER_STREAM_STREAM_RULE_H_
+
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "base/values.h"
+#include "url/gurl.h"
+
+namespace datasipper {
+
+// Types of stream matching criteria
+enum class StreamMatchType {
+  URL_PATTERN,          // Match URL with wildcards/regex
+  HOST_EXACT,           // Exact hostname match
+  PATH_PREFIX,          // URL path starts with prefix
+  METHOD_EXACT,         // HTTP method match
+  HEADER_CONTAINS,      // Header contains value
+  WEBSOCKET_PROTOCOL,   // WebSocket subprotocol
+  CONTENT_TYPE,         // Response content type
+  STATUS_CODE,          // HTTP status code
+  CUSTOM_JAVASCRIPT     // Custom JavaScript matcher
+};
+
+// Stream rule condition
+struct StreamCondition {
+  StreamMatchType type;
+  std::string pattern;      // Pattern to match against
+  std::string value;        // Expected value (for exact matches)
+  bool case_sensitive = false;
+  bool negate = false;      // Invert match result
+  
+  StreamCondition();
+  StreamCondition(StreamMatchType type, const std::string& pattern);
+  StreamCondition(StreamMatchType type, const std::string& pattern, const std::string& value);
+  ~StreamCondition();
+  
+  // Convert to/from base::Value for persistence
+  base::Value::Dict ToDict() const;
+  static std::unique_ptr<StreamCondition> FromDict(const base::Value::Dict& dict);
+};
+
+// Complete stream rule with multiple conditions
+class StreamRule {
+ public:
+  StreamRule();
+  explicit StreamRule(const std::string& name);
+  ~StreamRule();
+  
+  StreamRule(const StreamRule&) = delete;
+  StreamRule& operator=(const StreamRule&) = delete;
+  
+  StreamRule(StreamRule&& other);
+  StreamRule& operator=(StreamRule&& other);
+
+  // Basic properties
+  const std::string& name() const { return name_; }
+  void set_name(const std::string& name) { name_ = name; }
+  
+  const std::string& description() const { return description_; }
+  void set_description(const std::string& description) { description_ = description; }
+  
+  bool enabled() const { return enabled_; }
+  void set_enabled(bool enabled) { enabled_ = enabled; }
+  
+  // Condition management
+  void AddCondition(std::unique_ptr<StreamCondition> condition);
+  void RemoveCondition(size_t index);
+  const std::vector<std::unique_ptr<StreamCondition>>& conditions() const { return conditions_; }
+  
+  // Logic mode for combining conditions
+  enum class LogicMode {
+    AND,  // All conditions must match
+    OR    // Any condition can match
+  };
+  
+  LogicMode logic_mode() const { return logic_mode_; }
+  void set_logic_mode(LogicMode mode) { logic_mode_ = mode; }
+  
+  // Stream grouping
+  const std::string& group_name() const { return group_name_; }
+  void set_group_name(const std::string& group_name) { group_name_ = group_name; }
+  
+  // Output routing
+  const std::string& output_target() const { return output_target_; }
+  void set_output_target(const std::string& target) { output_target_ = target; }
+  
+  // Matching
+  bool Matches(const base::Value::Dict& event_data) const;
+  
+  // Serialization
+  base::Value::Dict ToDict() const;
+  static std::unique_ptr<StreamRule> FromDict(const base::Value::Dict& dict);
+  
+ private:
+  bool EvaluateCondition(const StreamCondition& condition, 
+                        const base::Value::Dict& event_data) const;
+  bool MatchesURL(const StreamCondition& condition, const std::string& url) const;
+  bool MatchesPattern(const std::string& pattern, const std::string& text, 
+                     bool case_sensitive) const;
+  
+  std::string name_;
+  std::string description_;
+  bool enabled_ = true;
+  LogicMode logic_mode_ = LogicMode::AND;
+  std::string group_name_;
+  std::string output_target_;
+  
+  std::vector<std::unique_ptr<StreamCondition>> conditions_;
+};
+
+}  // namespace datasipper
+
+#endif  // COMPONENTS_DATASIPPER_STREAM_STREAM_RULE_H_
