#
# This patch implements the transformation engine that allows users to
# transform network data using JavaScript before routing to output services.
#
# Affects:
# - components/datasipper/transform/ (new directory)
# - components/datasipper/transform/javascript_transformer.h (new file)
# - components/datasipper/transform/javascript_transformer.cc (new file)
