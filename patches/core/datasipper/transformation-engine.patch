+
+#ifndef COMPONENTS_DATASIPPER_TRANSFORM_JAVASCRIPT_TRANSFORMER_H_
+#define COMPONENTS_DATASIPPER_TRANSFORM_JAVASCRIPT_TRANSFORMER_H_
+
+#include <memory>
+#include <string>
+
+#include "base/memory/weak_ptr.h"
+#include "components/datasipper/transform/transformation_context.h"
+#include "v8/include/v8.h"
+
+namespace datasipper {
+
+// JavaScript execution environment for data transformation
+class JavaScriptTransformer {
+ public:
+  JavaScriptTransformer();
+  ~JavaScriptTransformer();
+  
+  JavaScriptTransformer(const JavaScriptTransformer&) = delete;
+  JavaScriptTransformer& operator=(const JavaScriptTransformer&) = delete;
+
+  // Initialize the V8 context and built-in functions
+  bool Initialize();
+  void Shutdown();
+  
+  // Execute transformation script
+  TransformationResult Transform(const TransformationContext& context,
+                                const std::string& javascript_code);
+  
+  // Validate JavaScript code without executing
+  bool ValidateScript(const std::string& javascript_code, std::string* error_message = nullptr);
+  
+  // Pre-compile scripts for better performance
+  bool CompileScript(const std::string& name, const std::string& javascript_code);
+  TransformationResult ExecuteCompiledScript(const std::string& name, 
+                                           const TransformationContext& context);
+  void RemoveCompiledScript(const std::string& name);
+  
+ private:
+  // V8 setup and teardown
+  bool SetupV8Context();
+  void SetupBuiltinFunctions();
+  void SetupGlobalObjects();
+  
+  // Context injection
+  void InjectTransformationContext(const TransformationContext& context);
+  void InjectUtilityFunctions();
+  
+  // Built-in utility functions for JavaScript
+  static void JSLog(const v8::FunctionCallbackInfo<v8::Value>& args);
+  static void JSParseJSON(const v8::FunctionCallbackInfo<v8::Value>& args);
+  static void JSStringifyJSON(const v8::FunctionCallbackInfo<v8::Value>& args);
+  static void JSExtractPath(const v8::FunctionCallbackInfo<v8::Value>& args);
+  static void JSBase64Encode(const v8::FunctionCallbackInfo<v8::Value>& args);
+  static void JSBase64Decode(const v8::FunctionCallbackInfo<v8::Value>& args);
+  static void JSURLParse(const v8::FunctionCallbackInfo<v8::Value>& args);
+  static void JSTimestamp(const v8::FunctionCallbackInfo<v8::Value>& args);
+  static void JSHash(const v8::FunctionCallbackInfo<v8::Value>& args);
+  static void JSRegexMatch(const v8::FunctionCallbackInfo<v8::Value>& args);
+  
+  // Helper methods
+  v8::Local<v8::Value> JSONToV8(const base::Value& json_value);
+  base::Value V8ToJSON(v8::Local<v8::Value> v8_value);
+  std::string V8ToString(v8::Local<v8::Value> v8_value);
+  
+  // Error handling
+  std::string ExtractV8Error(v8::TryCatch& try_catch);
+  
+  // V8 isolate and context
+  std::unique_ptr<v8::Isolate, void(*)(v8::Isolate*)> isolate_;
+  v8::Global<v8::Context> context_;
+  
+  // Compiled scripts cache
+  std::map<std::string, v8::Global<v8::Script>> compiled_scripts_;
+  
+  // Security and performance limits
+  static constexpr int kMaxExecutionTimeMs = 5000;    // 5 second timeout
+  static constexpr size_t kMaxMemoryUsage = 50 * 1024 * 1024;  // 50MB limit
+  static constexpr size_t kMaxStackDepth = 100;
+  
+  bool initialized_ = false;
+  
+  base::WeakPtrFactory<JavaScriptTransformer> weak_factory_{this};
+};
+
+// Global transformer instance management
+class TransformerManager {
+ public:
+  static TransformerManager* GetInstance();
+  
+  JavaScriptTransformer* GetTransformer();
+  void ReleaseTransformer(JavaScriptTransformer* transformer);
+  
+ private:
+  // Pool of transformer instances for thread safety
+  std::vector<std::unique_ptr<JavaScriptTransformer>> transformer_pool_;
+  base::Lock pool_lock_;
+};
+
+}  // namespace datasipper
+
+#endif  // COMPONENTS_DATASIPPER_TRANSFORM_JAVASCRIPT_TRANSFORMER_H_
