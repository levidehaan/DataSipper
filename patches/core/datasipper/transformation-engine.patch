+#ifndef COMPONENTS_DATASIPPER_TRANSFORM_TRANSFORMATION_CONTEXT_H_
+#define COMPONENTS_DATASIPPER_TRANSFORM_TRANSFORMATION_CONTEXT_H_
+
+#include <memory>
+#include <string>
+
+#include "base/time/time.h"
+#include "base/values.h"
+#include "url/gurl.h"
+
+namespace datasipper {
+
+// Context information available during transformation
+struct TransformationContext {
+  // Event metadata
+  std::string event_type;          // "http_request", "http_response", "websocket_message"
+  base::Time timestamp;
+  std::string connection_id;
+  
+  // HTTP-specific context
+  GURL url;
+  std::string method;
+  int status_code = 0;
+  base::Value::Dict request_headers;
+  base::Value::Dict response_headers;
+  std::string request_body;
+  std::string response_body;
+  int64_t request_size = 0;
+  int64_t response_size = 0;
+  int duration_ms = 0;
+  
+  // WebSocket-specific context
+  std::string websocket_protocol;
+  std::string message_payload;
+  bool is_outgoing = false;
+  std::string frame_type;
+  
+  // Stream context
+  std::string stream_name;
+  std::string group_name;
+  size_t event_sequence = 0;       // Sequence number within group
+  
+  // Utility methods
+  base::Value::Dict ToDict() const;
+  static TransformationContext FromDict(const base::Value::Dict& dict);
+  
+  // Helper methods for JavaScript
+  std::string GetHost() const;
+  std::string GetPath() const;
+  std::string GetQuery() const;
+  std::string GetHeader(const std::string& name) const;
+  bool HasHeader(const std::string& name) const;
+  std::string ExtractJsonField(const std::string& json_text, const std::string& field_path) const;
+};
+
+// Result of a transformation operation
+struct TransformationResult {
+  bool success = false;
+  std::string error_message;
+  base::Value::Dict transformed_data;
+  
+  // Output routing overrides (if specified by transformation)
+  std::string output_type;         // Override output type
+  std::string kafka_topic;         // Override Kafka topic
+  int kafka_partition = -1;        // Override Kafka partition
+  std::string redis_key;           // Override Redis key
+  std::string redis_channel;       // Override Redis channel
+  
+  // Metadata
+  base::Time transformation_time;
+  int execution_time_ms = 0;
+  
+  static TransformationResult Success(base::Value::Dict data);
+  static TransformationResult Error(const std::string& error);
+};
+
+}  // namespace datasipper
+
+#endif  // COMPONENTS_DATASIPPER_TRANSFORM_TRANSFORMATION_CONTEXT_H_
