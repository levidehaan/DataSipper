+// Copyright 2024 The DataSipper Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_DATASIPPER_STORAGE_CIRCULAR_EVENT_BUFFER_H_
+#define COMPONENTS_DATASIPPER_STORAGE_CIRCULAR_EVENT_BUFFER_H_
+
+#include <deque>
+#include <memory>
+
+#include "base/circular_deque.h"
+#include "base/memory/weak_ptr.h"
+#include "base/synchronization/lock.h"
+#include "base/time/time.h"
+#include "base/values.h"
+
+namespace datasipper {
+
+// Event types for the circular buffer
+enum class EventType {
+  HTTP_REQUEST,
+  HTTP_RESPONSE,
+  WEBSOCKET_CONNECT,
+  WEBSOCKET_MESSAGE_SENT,
+  WEBSOCKET_MESSAGE_RECEIVED,
+  WEBSOCKET_DISCONNECT,
+};
+
+// A single event in the circular buffer
+struct NetworkEvent {
+  EventType type;
+  base::Time timestamp;
+  std::string connection_id;  // Unique identifier for the connection/request
+  base::Value::Dict data;     // Event-specific data (URL, headers, payload, etc.)
+  
+  NetworkEvent();
+  NetworkEvent(EventType type, const std::string& connection_id, base::Value::Dict data);
+  ~NetworkEvent();
+  
+  NetworkEvent(const NetworkEvent&) = delete;
+  NetworkEvent& operator=(const NetworkEvent&) = delete;
+  
+  NetworkEvent(NetworkEvent&& other);
+  NetworkEvent& operator=(NetworkEvent&& other);
+};
+
+// Thread-safe circular buffer for storing recent network events
+// for real-time display in the DataSipper panel.
+class CircularEventBuffer {
+ public:
+  explicit CircularEventBuffer(size_t max_size = 10000);
+  ~CircularEventBuffer();
+
+  CircularEventBuffer(const CircularEventBuffer&) = delete;
+  CircularEventBuffer& operator=(const CircularEventBuffer&) = delete;
+
+  // Add event to the buffer (thread-safe)
+  void AddEvent(NetworkEvent event);
+
+  // Get recent events (thread-safe)
+  std::vector<NetworkEvent> GetRecentEvents(size_t count = 100) const;
+  std::vector<NetworkEvent> GetEventsSince(base::Time since) const;
+  std::vector<NetworkEvent> GetEventsForConnection(const std::string& connection_id) const;
+
+  // Buffer management
+  void Clear();
+  size_t GetSize() const;
+  size_t GetMaxSize() const { return max_size_; }
+  void SetMaxSize(size_t max_size);
+
+  // Statistics
+  size_t GetEventCount() const;
+  base::Time GetOldestEventTime() const;
+  base::Time GetNewestEventTime() const;
+
+ private:
+  mutable base::Lock lock_;
+  base::circular_deque<std::unique_ptr<NetworkEvent>> events_;
+  size_t max_size_;
+  size_t total_events_added_ = 0;
+
+  // Helper methods (called while holding lock_)
+  void RemoveOldEventsLocked();
+  
+  base::WeakPtrFactory<CircularEventBuffer> weak_factory_{this};
+};
+
+}  // namespace datasipper
+
+#endif  // COMPONENTS_DATASIPPER_STORAGE_CIRCULAR_EVENT_BUFFER_H_