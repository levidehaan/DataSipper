+// Copyright 2024 The DataSipper Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_DATASIPPER_DATASIPPER_SERVICE_H_
+#define COMPONENTS_DATASIPPER_DATASIPPER_SERVICE_H_
+
+#include <memory>
+
+#include "base/memory/weak_ptr.h"
+#include "components/keyed_service/core/keyed_service.h"
+
+namespace base {
+class FilePath;
+}
+
+namespace datasipper {
+
+class DataSipperDatabase;
+class NetworkEventStorage;
+class WebSocketMessageStorage;
+class CircularEventBuffer;
+
+// Main service class that coordinates DataSipper functionality
+// and manages the lifecycle of storage components.
+class DataSipperService : public KeyedService {
+ public:
+  explicit DataSipperService(const base::FilePath& database_path);
+  ~DataSipperService() override;
+
+  DataSipperService(const DataSipperService&) = delete;
+  DataSipperService& operator=(const DataSipperService&) = delete;
+
+  // KeyedService implementation
+  void Shutdown() override;
+
+  // Initialize the service and database
+  bool Initialize();
+
+  // Accessors for storage components
+  NetworkEventStorage* network_event_storage() { return network_event_storage_.get(); }
+  WebSocketMessageStorage* websocket_message_storage() { return websocket_message_storage_.get(); }
+  CircularEventBuffer* circular_event_buffer() { return circular_event_buffer_.get(); }
+
+  // Service state
+  bool IsInitialized() const { return initialized_; }
+
+ private:
+  // Initialize database and storage components
+  bool InitializeDatabase();
+  bool InitializeStorageComponents();
+
+  base::FilePath database_path_;
+  bool initialized_ = false;
+
+  // Storage components
+  std::unique_ptr<DataSipperDatabase> database_;
+  std::unique_ptr<NetworkEventStorage> network_event_storage_;
+  std::unique_ptr<WebSocketMessageStorage> websocket_message_storage_;
+  std::unique_ptr<CircularEventBuffer> circular_event_buffer_;
+
+  base::WeakPtrFactory<DataSipperService> weak_factory_{this};
+};
+
+}  // namespace datasipper
+
+#endif  // COMPONENTS_DATASIPPER_DATASIPPER_SERVICE_H_
