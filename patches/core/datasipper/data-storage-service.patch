+#include "components/datasipper/storage/data_storage_service.h"
+
+#include <algorithm>
+#include <utility>
+
+#include "base/files/file_util.h"
+#include "base/json/json_writer.h"
+#include "base/logging.h"
+#include "base/task/thread_pool.h"
+#include "chrome/browser/profiles/profile.h"
+#include "components/datasipper/database/datasipper_database.h"
+#include "components/datasipper/storage/circular_event_buffer.h"
+#include "sql/database.h"
+
+namespace datasipper {
+
+DataStorageService::DataStorageService(Profile* profile) 
+    : profile_(profile) {
+  DCHECK(profile_);
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+}
+
+DataStorageService::~DataStorageService() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  Shutdown();
+}
+
+void DataStorageService::Initialize(const DataStorageConfig& config) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  
+  if (initialized_) {
+    LOG(WARNING) << "DataStorageService already initialized";
+    return;
+  }
+  
+  config_ = config;
+  
+  LOG(INFO) << "Initializing DataStorageService";
+  LOG(INFO) << "  Memory buffer size: " << config_.memory_buffer_size;
+  LOG(INFO) << "  Persistence enabled: " << config_.enable_persistence;
+  LOG(INFO) << "  Retention days: " << config_.retention_days;
+  
+  // Initialize main memory buffer
+  main_buffer_ = std::make_unique<CircularEventBuffer>(config_.memory_buffer_size);
+  main_buffer_->AddObserver(this);
+  
+  // Initialize stream manager
+  stream_manager_ = std::make_unique<EventStreamManager>(
+      config_.default_stream_buffer_size);
+  stream_manager_->AddObserver(this);
+  
+  // Initialize database if persistence is enabled
+  if (config_.enable_persistence) {
+    InitializeDatabase();
+  }
+  
+  // Set up background task runner
+  background_task_runner_ = base::ThreadPool::CreateSequencedTaskRunner(
+      {base::MayBlock(), base::TaskPriority::BEST_EFFORT});
+  
+  // Schedule background tasks
+  ScheduleBackgroundTasks();
+  
+  initialized_ = true;
+  LOG(INFO) << "DataStorageService initialized successfully";
+}
+
+void DataStorageService::Shutdown() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  
+  if (!initialized_) {
+    return;
+  }
+  
+  LOG(INFO) << "Shutting down DataStorageService";
+  
+  // Stop background tasks
+  flush_timer_.reset();
+  cleanup_timer_.reset();
+  
+  // Flush any pending data
+  FlushToDisk();
+  
+  // Clean up components
+  if (main_buffer_) {
+    main_buffer_->RemoveObserver(this);
+    main_buffer_.reset();
+  }
+  
+  if (stream_manager_) {
+    stream_manager_->RemoveObserver(this);
+    stream_manager_.reset();
+  }
+  
+  database_.reset();
+  
+  initialized_ = false;
+  LOG(INFO) << "DataStorageService shutdown complete";
+}
+
+void DataStorageService::StoreEvent(std::unique_ptr<NetworkEvent> event) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  
+  if (!initialized_ || !event) {
+    return;
+  }
+  
+  // Add to main buffer
+  main_buffer_->AddEvent(std::move(event));
+  
+  // Check memory limits
+  CheckMemoryLimits();
+}
+
+void DataStorageService::StoreEvents(
+    std::vector<std::unique_ptr<NetworkEvent>> events) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  
+  if (!initialized_) {
+    return;
+  }
+  
+  for (auto& event : events) {
+    if (event) {
+      main_buffer_->AddEvent(std::move(event));
+    }
+  }
+  
+  CheckMemoryLimits();
+}
+
+std::vector<std::unique_ptr<NetworkEvent>> 
+DataStorageService::GetRecentEvents(size_t count) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  
+  if (!initialized_) {
+    return {};
+  }
+  
+  return main_buffer_->GetEvents(count);
+}
+
+std::vector<std::unique_ptr<NetworkEvent>> 
+DataStorageService::GetEventsSince(base::Time since) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  
+  if (!initialized_) {
+    return {};
+  }
+  
+  auto memory_events = main_buffer_->GetEventsSince(since);
+  
+  // TODO: Also query database for events before memory buffer time range
+  
+  return memory_events;
+}
+
+std::vector<std::unique_ptr<NetworkEvent>> 
+DataStorageService::GetEventsFromStream(const std::string& stream_name, 
+                                       size_t count) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  
+  if (!initialized_) {
+    return {};
+  }
+  
+  return stream_manager_->GetEventsFromStream(stream_name, count);
+}
+
+std::unique_ptr<NetworkEvent> 
+DataStorageService::GetEventById(const std::string& event_id) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  
+  if (!initialized_) {
+    return nullptr;
+  }
+  
+  // First check memory buffer
+  auto event = main_buffer_->GetEvent(event_id);
+  if (event) {
+    return event;
+  }
+  
+  // TODO: Query database if not found in memory
+  
+  return nullptr;
+}
+
+void DataStorageService::CreateStream(const std::string& stream_name) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  
+  if (!initialized_) {
+    return;
+  }
+  
+  stream_manager_->CreateStream(stream_name, config_.default_stream_buffer_size);
+}
+
+void DataStorageService::DeleteStream(const std::string& stream_name) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  
+  if (!initialized_) {
+    return;
+  }
+  
+  stream_manager_->DestroyStream(stream_name);
+}
+
+std::vector<std::string> DataStorageService::GetStreamNames() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  
+  if (!initialized_) {
+    return {};
+  }
+  
+  return stream_manager_->GetStreamNames();
+}
+
+StreamStatistics DataStorageService::GetStreamStatistics(
+    const std::string& stream_name) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  
+  if (!initialized_) {
+    return StreamStatistics();
+  }
+  
+  return stream_manager_->GetStreamStatistics(stream_name);
+}
+
+DataStorageService::StorageStatistics 
+DataStorageService::GetStorageStatistics() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  
+  if (!initialized_) {
+    return StorageStatistics();
+  }
+  
+  // Update cached statistics if needed
+  base::Time now = base::Time::Now();
+  if (now - last_statistics_update_ > base::Seconds(5)) {
+    cached_statistics_.memory_events_count = main_buffer_->GetSize();
+    cached_statistics_.total_memory_usage_bytes = stream_manager_->GetTotalMemoryUsage();
+    cached_statistics_.active_streams_count = stream_manager_->GetStreamNames().size();
+    cached_statistics_.oldest_event_time = main_buffer_->GetOldestEventTime();
+    cached_statistics_.newest_event_time = main_buffer_->GetNewestEventTime();
+    
+    // Calculate events per minute
+    if (!cached_statistics_.oldest_event_time.is_null() && 
+        !cached_statistics_.newest_event_time.is_null()) {
+      base::TimeDelta time_span = 
+          cached_statistics_.newest_event_time - cached_statistics_.oldest_event_time;
+      if (time_span.InMinutes() > 0) {
+        cached_statistics_.avg_events_per_minute = 
+            static_cast<double>(cached_statistics_.memory_events_count) / 
+            time_span.InMinutes();
+      }
+    }
+    
+    last_statistics_update_ = now;
+  }
+  
+  return cached_statistics_;
+}
+
+std::map<std::string, StreamStatistics> 
+DataStorageService::GetAllStreamStatistics() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  
+  if (!initialized_) {
+    return {};
+  }
+  
+  return stream_manager_->GetAllStreamStatistics();
+}
+
+void DataStorageService::FlushToDisk() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  
+  if (!initialized_ || !config_.enable_persistence) {
+    return;
+  }
+  
+  FlushPendingEventsToDisk();
+}
+
+void DataStorageService::InitializeDatabase() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  
+  base::FilePath database_path = profile_->GetPath().Append(
+      FILE_PATH_LITERAL("DataSipper"));
+  
+  database_ = std::make_unique<DataSipperDatabase>(database_path);
+  
+  // Initialize on background thread
+  background_task_runner_->PostTask(
+      FROM_HERE,
+      base::BindOnce([](DataSipperDatabase* db) {
+        if (!db->Initialize()) {
+          LOG(ERROR) << "Failed to initialize DataSipper database";
+        }
+      }, database_.get()));
+}
+
+void DataStorageService::ScheduleBackgroundTasks() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  
+  // Set up flush timer
+  flush_timer_ = std::make_unique<base::RepeatingTimer>();
+  flush_timer_->Start(
+      FROM_HERE, 
+      config_.flush_interval,
+      base::BindRepeating(&DataStorageService::OnFlushTimer, 
+                         weak_factory_.GetWeakPtr()));
+  
+  // Set up cleanup timer
+  cleanup_timer_ = std::make_unique<base::RepeatingTimer>();
+  cleanup_timer_->Start(
+      FROM_HERE,
+      config_.cleanup_interval,
+      base::BindRepeating(&DataStorageService::OnCleanupTimer,
+                         weak_factory_.GetWeakPtr()));
+}
+
+void DataStorageService::OnFlushTimer() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  FlushToDisk();
+}
+
+void DataStorageService::OnCleanupTimer() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  RunCleanup();
+}
+
+void DataStorageService::CheckMemoryLimits() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  
+  size_t current_usage = stream_manager_->GetTotalMemoryUsage();
+  size_t limit_bytes = config_.max_memory_usage_mb * 1024 * 1024;
+  
+  if (current_usage > limit_bytes) {
+    LOG(INFO) << "Memory usage (" << current_usage / 1024 / 1024 
+              << "MB) exceeds limit (" << config_.max_memory_usage_mb 
+              << "MB), trimming buffers";
+    
+    TrimMemoryUsage();
+  }
+}
+
+void DataStorageService::TrimMemoryUsage() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  
+  // Calculate target size (80% of limit)
+  size_t target_total_bytes = config_.max_memory_usage_mb * 1024 * 1024 * 0.8;
+  size_t current_usage = stream_manager_->GetTotalMemoryUsage();
+  
+  if (current_usage <= target_total_bytes) {
+    return;
+  }
+  
+  // Trim all streams proportionally
+  auto stream_names = stream_manager_->GetStreamNames();
+  if (!stream_names.empty()) {
+    size_t target_per_stream = target_total_bytes / stream_names.size();
+    stream_manager_->TrimAllStreams(target_per_stream);
+  }
+  
+  LOG(INFO) << "Memory trimmed from " << current_usage / 1024 / 1024 
+            << "MB to approximately " << target_total_bytes / 1024 / 1024 << "MB";
+}
+
+void DataStorageService::RunCleanup() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  
+  if (!initialized_ || !config_.enable_persistence || !database_) {
+    return;
+  }
+  
+  LOG(INFO) << "Running data cleanup (retention: " << config_.retention_days << " days)";
+  
+  // Run cleanup on background thread
+  background_task_runner_->PostTaskAndReplyWithResult(
+      FROM_HERE,
+      base::BindOnce([](DataSipperDatabase* db, int retention_days) -> size_t {
+        return db->CleanupOldData(retention_days);
+      }, database_.get(), config_.retention_days),
+      base::BindOnce([](base::WeakPtr<DataStorageService> service, size_t removed_count) {
+        if (service) {
+          service->NotifyCleanupCompleted(removed_count);
+        }
+      }, weak_factory_.GetWeakPtr()));
+}
+
+void DataStorageService::FlushPendingEventsToDisk() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  
+  if (pending_database_inserts_.empty() || !database_) {
+    return;
+  }
+  
+  // Move pending events to background thread for processing
+  auto events_to_persist = std::move(pending_database_inserts_);
+  pending_database_inserts_.clear();
+  
+  size_t event_count = events_to_persist.size();
+  
+  background_task_runner_->PostTaskAndReply(
+      FROM_HERE,
+      base::BindOnce([](DataSipperDatabase* db, 
+                       std::vector<std::unique_ptr<NetworkEvent>> events) {
+        for (auto& event : events) {
+          db->StoreNetworkEvent(*event);
+        }
+      }, database_.get(), std::move(events_to_persist)),
+      base::BindOnce([](base::WeakPtr<DataStorageService> service, size_t count) {
+        if (service) {
+          service->NotifyEventsPersisted(count);
+        }
+      }, weak_factory_.GetWeakPtr(), event_count));
+}
+
+// EventStreamObserver implementation
+void DataStorageService::OnStreamCreated(const std::string& stream_name) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  LOG(INFO) << "Stream created: " << stream_name;
+}
+
+void DataStorageService::OnStreamDestroyed(const std::string& stream_name) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  LOG(INFO) << "Stream destroyed: " << stream_name;
+}
+
+void DataStorageService::OnEventRouted(const std::string& stream_name, 
+                                      const NetworkEvent& event) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  
+  // Add to pending database inserts if persistence is enabled
+  if (config_.enable_persistence) {
+    auto event_copy = std::make_unique<NetworkEvent>();
+    *event_copy = event;  // Copy the event
+    pending_database_inserts_.push_back(std::move(event_copy));
+    
+    // Flush if batch size reached
+    if (pending_database_inserts_.size() >= config_.batch_insert_size) {
+      FlushPendingEventsToDisk();
+    }
+  }
+  
+  NotifyEventStored(event);
+}
+
+void DataStorageService::OnStreamStatisticsUpdated(const std::string& stream_name) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  // Statistics updated - invalidate cache
+  last_statistics_update_ = base::Time();
+}
+
+void DataStorageService::AddObserver(DataStorageObserver* observer) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  observers_.push_back(observer);
+}
+
+void DataStorageService::RemoveObserver(DataStorageObserver* observer) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  auto it = std::find(observers_.begin(), observers_.end(), observer);
+  if (it != observers_.end()) {
+    observers_.erase(it);
+  }
+}
+
+void DataStorageService::NotifyEventStored(const NetworkEvent& event) {
+  for (auto* observer : observers_) {
+    observer->OnEventStored(event);
+  }
+}
+
+void DataStorageService::NotifyEventsPersisted(size_t count) {
+  for (auto* observer : observers_) {
+    observer->OnEventsPersisted(count);
+  }
+}
+
+void DataStorageService::NotifyStorageError(const std::string& error) {
+  for (auto* observer : observers_) {
+    observer->OnStorageError(error);
+  }
+}
+
+void DataStorageService::NotifyCleanupCompleted(size_t events_removed) {
+  LOG(INFO) << "Cleanup completed: " << events_removed << " events removed";
+  for (auto* observer : observers_) {
+    observer->OnCleanupCompleted(events_removed);
+  }
+}
+
+}  // namespace datasipper