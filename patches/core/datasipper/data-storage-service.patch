+#ifndef COMPONENTS_DATASIPPER_STORAGE_DATA_STORAGE_SERVICE_H_
+#define COMPONENTS_DATASIPPER_STORAGE_DATA_STORAGE_SERVICE_H_
+
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/memory/weak_ptr.h"
+#include "base/sequence_checker.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/timer/timer.h"
+#include "components/datasipper/common/network_event.h"
+#include "components/datasipper/storage/event_stream_manager.h"
+#include "sql/database.h"
+
+class Profile;
+
+namespace datasipper {
+
+class CircularEventBuffer;
+class DataSipperDatabase;
+
+// Configuration for data storage behavior
+struct DataStorageConfig {
+  // Memory buffer settings
+  size_t memory_buffer_size = 10000;
+  size_t max_memory_usage_mb = 100;
+  
+  // Database settings
+  bool enable_persistence = true;
+  int retention_days = 7;
+  size_t max_db_size_mb = 500;
+  
+  // Performance settings
+  size_t batch_insert_size = 100;
+  base::TimeDelta flush_interval = base::Seconds(30);
+  base::TimeDelta cleanup_interval = base::Hours(24);
+  
+  // Stream settings
+  size_t max_streams = 50;
+  size_t default_stream_buffer_size = 1000;
+  
+  // Data capture settings
+  bool capture_request_bodies = true;
+  bool capture_response_bodies = true;
+  size_t max_body_size = 1024 * 1024;  // 1MB
+  
+  DataStorageConfig() = default;
+  ~DataStorageConfig() = default;
+};
+
+// Observer interface for storage events
+class DataStorageObserver {
+ public:
+  virtual ~DataStorageObserver() = default;
+  virtual void OnEventStored(const NetworkEvent& event) = 0;
+  virtual void OnEventsPersisted(size_t count) = 0;
+  virtual void OnStorageError(const std::string& error) = 0;
+  virtual void OnCleanupCompleted(size_t events_removed) = 0;
+};
+
+// Main data storage service coordinating all storage operations
+class DataStorageService : public EventStreamObserver {
+ public:
+  explicit DataStorageService(Profile* profile);
+  ~DataStorageService() override;
+
+  DataStorageService(const DataStorageService&) = delete;
+  DataStorageService& operator=(const DataStorageService&) = delete;
+
+  // Initialization and shutdown
+  void Initialize(const DataStorageConfig& config = DataStorageConfig());
+  void Shutdown();
+  bool IsInitialized() const { return initialized_; }
+  
+  // Event storage
+  void StoreEvent(std::unique_ptr<NetworkEvent> event);
+  void StoreEvents(std::vector<std::unique_ptr<NetworkEvent>> events);
+  
+  // Event retrieval
+  std::vector<std::unique_ptr<NetworkEvent>> GetRecentEvents(size_t count = 100);
+  std::vector<std::unique_ptr<NetworkEvent>> GetEventsSince(base::Time since);
+  std::vector<std::unique_ptr<NetworkEvent>> GetEventsFromStream(
+      const std::string& stream_name, size_t count = 100);
+  std::unique_ptr<NetworkEvent> GetEventById(const std::string& event_id);
+  
+  // Stream management
+  void CreateStream(const std::string& stream_name);
+  void DeleteStream(const std::string& stream_name);
+  std::vector<std::string> GetStreamNames();
+  StreamStatistics GetStreamStatistics(const std::string& stream_name);
+  
+  // Search and filtering
+  std::vector<std::unique_ptr<NetworkEvent>> SearchEvents(
+      const std::string& query, size_t max_results = 100);
+  std::vector<std::unique_ptr<NetworkEvent>> FilterEventsByUrl(
+      const std::string& url_pattern, size_t max_results = 100);
+  std::vector<std::unique_ptr<NetworkEvent>> FilterEventsByMethod(
+      const std::string& method, size_t max_results = 100);
+  std::vector<std::unique_ptr<NetworkEvent>> FilterEventsByStatusCode(
+      int status_code, size_t max_results = 100);
+  
+  // Analytics and statistics
+  struct StorageStatistics {
+    size_t total_events_stored = 0;
+    size_t memory_events_count = 0;
+    size_t persistent_events_count = 0;
+    size_t total_memory_usage_bytes = 0;
+    size_t database_size_bytes = 0;
+    size_t active_streams_count = 0;
+    base::Time oldest_event_time;
+    base::Time newest_event_time;
+    double avg_events_per_minute = 0.0;
+  };
+  
+  StorageStatistics GetStorageStatistics();
+  std::map<std::string, StreamStatistics> GetAllStreamStatistics();
+  
+  // Configuration management
+  void UpdateConfig(const DataStorageConfig& config);
+  const DataStorageConfig& GetConfig() const { return config_; }
+  
+  // Memory management
+  void TrimMemoryUsage();
+  void FlushToDisk();
+  void ClearMemoryBuffers();
+  
+  // Maintenance operations
+  void RunCleanup();
+  void OptimizeDatabase();
+  void ExportData(const base::FilePath& export_path, 
+                  const std::string& format = "json");
+  
+  // Observer management
+  void AddObserver(DataStorageObserver* observer);
+  void RemoveObserver(DataStorageObserver* observer);
+  
+  // EventStreamObserver implementation
+  void OnStreamCreated(const std::string& stream_name) override;
+  void OnStreamDestroyed(const std::string& stream_name) override;
+  void OnEventRouted(const std::string& stream_name, 
+                    const NetworkEvent& event) override;
+  void OnStreamStatisticsUpdated(const std::string& stream_name) override;
+  
+ private:
+  // Background task management
+  void ScheduleBackgroundTasks();
+  void OnFlushTimer();
+  void OnCleanupTimer();
+  void FlushPendingEventsToDisk();
+  
+  // Database operations
+  void InitializeDatabase();
+  void PersistEventToDatabase(const NetworkEvent& event);
+  void PersistEventBatchToDatabase(
+      const std::vector<std::unique_ptr<NetworkEvent>>& events);
+  
+  // Memory management helpers
+  void CheckMemoryLimits();
+  void EvictOldestEvents(size_t count);
+  
+  // Observer notifications
+  void NotifyEventStored(const NetworkEvent& event);
+  void NotifyEventsPersisted(size_t count);
+  void NotifyStorageError(const std::string& error);
+  void NotifyCleanupCompleted(size_t events_removed);
+  
+  SEQUENCE_CHECKER(sequence_checker_);
+  
+  raw_ptr<Profile> profile_;
+  bool initialized_ = false;
+  DataStorageConfig config_;
+  
+  // Storage components
+  std::unique_ptr<DataSipperDatabase> database_;
+  std::unique_ptr<EventStreamManager> stream_manager_;
+  std::unique_ptr<CircularEventBuffer> main_buffer_;
+  
+  // Background task management
+  std::unique_ptr<base::RepeatingTimer> flush_timer_;
+  std::unique_ptr<base::RepeatingTimer> cleanup_timer_;
+  scoped_refptr<base::SequencedTaskRunner> background_task_runner_;
+  
+  // Pending operations
+  std::vector<std::unique_ptr<NetworkEvent>> pending_database_inserts_;
+  
+  // Observers
+  std::vector<DataStorageObserver*> observers_;
+  
+  // Statistics
+  mutable StorageStatistics cached_statistics_;
+  base::Time last_statistics_update_;
+  
+  base::WeakPtrFactory<DataStorageService> weak_factory_{this};
+};
+
+}  // namespace datasipper
+
+#endif  // COMPONENTS_DATASIPPER_STORAGE_DATA_STORAGE_SERVICE_H_
