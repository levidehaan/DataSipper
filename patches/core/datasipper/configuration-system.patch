+// Copyright 2024 The DataSipper Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/datasipper/browser/datasipper_prefs.h"
+
+#include "components/prefs/pref_registry_simple.h"
+#include "components/prefs/pref_service.h"
+
+namespace datasipper {
+namespace prefs {
+
+// DataSipper preference names
+const char kDataSipperEnabled[] = "datasipper.enabled";
+const char kDataSipperNetworkInterceptionEnabled[] = "datasipper.network_interception_enabled";
+const char kDataSipperUIEnabled[] = "datasipper.ui_enabled";
+const char kDataSipperMaxEventBufferSize[] = "datasipper.max_event_buffer_size";
+const char kDataSipperDataRetentionDays[] = "datasipper.data_retention_days";
+const char kDataSipperCaptureRequestBodies[] = "datasipper.capture_request_bodies";
+const char kDataSipperCaptureResponseBodies[] = "datasipper.capture_response_bodies";
+const char kDataSipperExternalIntegrationsEnabled[] = "datasipper.external_integrations_enabled";
+
+// Stream configuration preferences
+const char kDataSipperStreamRules[] = "datasipper.stream_rules";
+const char kDataSipperActiveStreams[] = "datasipper.active_streams";
+const char kDataSipperDefaultGroup[] = "datasipper.default_group";
+
+// Output configuration preferences
+const char kDataSipperKafkaConfig[] = "datasipper.kafka_config";
+const char kDataSipperRedisConfig[] = "datasipper.redis_config";
+const char kDataSipperMySQLConfig[] = "datasipper.mysql_config";
+const char kDataSipperWebhookConfig[] = "datasipper.webhook_config";
+
+void RegisterProfilePrefs(PrefRegistrySimple* registry) {
+  // Core DataSipper preferences
+  registry->RegisterBooleanPref(kDataSipperEnabled, true);
+  registry->RegisterBooleanPref(kDataSipperNetworkInterceptionEnabled, true);
+  registry->RegisterBooleanPref(kDataSipperUIEnabled, true);
+  
+  // Buffer and retention settings
+  registry->RegisterIntegerPref(kDataSipperMaxEventBufferSize, 10000);
+  registry->RegisterIntegerPref(kDataSipperDataRetentionDays, 7);
+  
+  // Data capture settings
+  registry->RegisterBooleanPref(kDataSipperCaptureRequestBodies, true);
+  registry->RegisterBooleanPref(kDataSipperCaptureResponseBodies, true);
+  
+  // External integrations
+  registry->RegisterBooleanPref(kDataSipperExternalIntegrationsEnabled, false);
+  
+  // Stream configuration (stored as JSON)
+  registry->RegisterListPref(kDataSipperStreamRules);
+  registry->RegisterListPref(kDataSipperActiveStreams);
+  registry->RegisterStringPref(kDataSipperDefaultGroup, "default");
+  
+  // Output configurations (stored as JSON dictionaries)
+  registry->RegisterDictionaryPref(kDataSipperKafkaConfig);
+  registry->RegisterDictionaryPref(kDataSipperRedisConfig);
+  registry->RegisterDictionaryPref(kDataSipperMySQLConfig);
+  registry->RegisterDictionaryPref(kDataSipperWebhookConfig);
+}
+
+bool IsDataSipperEnabled(PrefService* prefs) {
+  return prefs->GetBoolean(kDataSipperEnabled);
+}
+
+bool IsNetworkInterceptionEnabled(PrefService* prefs) {
+  return prefs->GetBoolean(kDataSipperNetworkInterceptionEnabled);
+}
+
+int GetMaxEventBufferSize(PrefService* prefs) {
+  return prefs->GetInteger(kDataSipperMaxEventBufferSize);
+}
+
+int GetDataRetentionDays(PrefService* prefs) {
+  return prefs->GetInteger(kDataSipperDataRetentionDays);
+}
+
+}  // namespace prefs
+}  // namespace datasipper
